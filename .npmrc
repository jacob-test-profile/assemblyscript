engine-strict=true

# legacy-peer-deps: typescript-eslint 8.65 peers typescript >=4.8.4 <6.1.0, but the
# root typescript is 7.1.0-beta (native). npm cannot nest a second typescript
# under typescript-eslint while the root depends on typescript directly, so a
# strict install fails ERESOLVE on the peer. The peer is satisfied at runtime
# instead: scripts/install-eslint-typescript.js (postinstall) links the official
# @typescript/typescript6 compat package in as typescript-eslint's typescript.
# Revisit when typescript-eslint supports TS >= 7.1
# (https://github.com/typescript-eslint/typescript-eslint/issues/10940).
legacy-peer-deps=true
